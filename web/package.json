{
  "name": "lifelines-web",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && node scripts/build-copy.mjs && next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/build-copy.mjs",
    "build": "next build",
    "start": "next start",
    "copy": "node scripts/build-copy.mjs",
    "sample:sync": "node -e \"require('fs').cpSync('../export/sample','public/data/sample',{recursive:true,filter:s=>!/\\.(py|html|md)$/.test(s)})\"",
    "check:route": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/route-check.mjs",
    "check:workspace": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/workspace-check.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^14.2.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.15.0",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
